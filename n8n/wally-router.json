        "url": "=https://graph.facebook.com/v21.0/PASTE_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.to, type: 'text', text: { body: $json.text } }) }}",
        "options": {}
      },
      "id": "97903161-1137-4a04-9905-184f4f8ce87d",
      "name": "Send WhatsApp to owner",
