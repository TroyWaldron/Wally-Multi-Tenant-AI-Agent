      "id": "625f8411-a8ef-401f-afec-135b04039a8d",
      "name": "Get Sunsational availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sunsational returns the villa's booked ranges; work out whether the\n// requested stay overlaps any of them.\nconst input = $('Verify & route').first().json.input || {};\nconst blocked = $input.first().json.blocked || [];\nconst ci = input.check_in, co = input.check_out;\nif (!ci || !co) {\n  return [{ json: { ok: false, message: 'Ask the guest for check-in and check-out dates (YYYY-MM-DD).' } }];\n}\nconst clashes = blocked.filter(r => ci < r.checkOut && co > r.checkIn);\nreturn [{ json: {\n  ok: true,\n  villa: input.villa,\n  check_in: ci,\n  check_out: co,\n  available: clashes.length === 0,\n  clashes,\n  note: clashes.length ? 'Those dates are taken. Offer nearby dates or another villa.' : 'Free. Offer to create an enquiry so the team can confirm and send the invoice.'\n} }];"
      },
      "id": "f7c82bc1-2e95-454e-ab1f-da12c65cd9d0",
      "name": "Check dates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        120
      ]
    },
    {
