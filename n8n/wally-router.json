      "id": "5ecd7dd9-a713-4f8a-ad90-069c05608a5a",
      "name": "Ack reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        920,
        360
      ]
    },
    {
      "parameters": {
        "jsCode": "// Builds a short WhatsApp text for the owner. Free-form WhatsApp messages\n// only deliver inside Meta's 24-hour window; outside it, switch the HTTP\n// node to an approved template.\nconst OWNER_WHATSAPP = 'PASTE_OWNER_NUMBER_E164_NO_PLUS';  // e.g. 18687825152\nconst b = $input.first().json;\nconst a = b.data?.approval;\nconst text = b.event === 'budget_exceeded'\n  ? `Wally: ${b.data.agent} hit its monthly budget and paused.`\n  : `Wally needs you (${b.tenant?.name}): ${a?.summary ?? 'a conversation was handed over'}. Open the Approvals inbox to decide.`;\nreturn [{ json: { to: OWNER_WHATSAPP, text } }];"
      },
      "id": "f1343bd3-e528-48cf-8160-ac7ac7f63354",
      "name": "Owner message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        480
      ]
    },
    {
