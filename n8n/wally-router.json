    {
      "parameters": {
        "jsCode": "// Wally -> n8n router. Paste the same shared secret you saved in\n// Wally > Settings > n8n, and your own values below.\nconst WALLY_SECRET = 'PASTE_THE_SHARED_SECRET_FROM_WALLY_SETTINGS';\n\nconst req = $input.first().json;\nconst body = req.body || {};\nconst headers = req.headers || {};\nlet route = 'unauthorized';\n\nif (headers['x-wally-secret'] === WALLY_SECRET) {\n  if (body.kind === 'workflow') {\n    route = ['check_availability', 'create_enquiry'].includes(body.workflow) ? body.workflow : 'unknown_workflow';\n  } else if (body.event === 'agent_replied' && body.data?.channel === 'whatsapp' && body.data?.contact?.phone) {\n    route = 'whatsapp_reply';\n  } else if (['approval_requested', 'escalated', 'budget_exceeded'].includes(body.event)) {\n    route = 'notify_owner';\n  } else {\n    route = 'other_event';\n  }\n}\nreturn [{ json: { route, ...body } }];"
      },
