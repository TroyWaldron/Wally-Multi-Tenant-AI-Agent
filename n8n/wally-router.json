        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.input.name, email: $json.input.email, phone: $json.input.phone || '', villaSlug: $json.input.villa || 'general', checkIn: $json.input.check_in || '', checkOut: $json.input.check_out || '', guests: $json.input.guests, message: 'Created by Wally (' + $json.context.agent + ')' }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
